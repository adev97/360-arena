% This file contains all the monitor information for the Two Photon Rig;
% all information is stored in a monitor structure

%%%%%%%%%%%%%%%%%%%%%%%% MONITOR INFORMATION %%%%%%%%%%%%%%%%%%%%%%%%%%%%%
monitorInfo.screenNumber = 2; %2;
% monitorInfo.screenDistcm = 20;
% monitorInfo.screenSizecmX = 59.9; %52.7;          
% monitorInfo.screenSizecmY = 33.7; %29.7;        
% monitorInfo.screenSizeDegX = 2*atan(monitorInfo.screenSizecmX/2/...
%                                 monitorInfo.screenDistcm)*180/pi;
% monitorInfo.screenSizeDegY = 2*atan(monitorInfo.screenSizecmY/2/...
%                                 monitorInfo.screenDistcm)*180/pi;
monitorInfo.screenSizeDegX = 240/90;
monitorInfo.screenSizeDegY = 960/360;
monitorInfo.screenSizePixX = 960;
monitorInfo.screenSizePixY = 240;
monitorInfo.degPerPix = monitorInfo.screenSizeDegY/...
                            monitorInfo.screenSizePixY;                     

monitorInfo.powerLawScaleFactor = .0001801;
monitorInfo.gamma = 2.386;
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%



